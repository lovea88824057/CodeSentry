# 用法：复制为 .env 并填入真实 key。.env 已在 .gitignore 中，不会入库。
#
# litellm 会按模型名前缀自动挑选对应的环境变量，例如：
#   deepseek/deepseek-chat  -> DEEPSEEK_API_KEY
#   openai/gpt-4o-mini      -> OPENAI_API_KEY
#   anthropic/claude-...    -> ANTHROPIC_API_KEY
#   ollama/qwen2.5-coder    -> 无需 key，走本地 http://localhost:11434

# 国内最常用：DeepSeek（便宜、代码能力好、OpenAI 兼容）
DEEPSEEK_API_KEY=

# OpenAI
OPENAI_API_KEY=

# 通义千问（DashScope 的 OpenAI 兼容端点）
DASHSCOPE_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# 可选：自定义 OpenAI 兼容端点的 base_url（vLLM / one-api / 中转站等）
# CODESENTRY_API_BASE=https://your-endpoint/v1

# 可选：覆盖模型（等价于 .codesentry.toml 里的 [config].model）
# CODESENTRY_MODEL=deepseek/deepseek-chat
