new file mode 100644
index 0000000..5555555
--- /dev/null
+++ b/app/retry.py
@@ -0,0 +1,16 @@
+"""重试工具。"""
+
+import time
+
+
+def retry(fn, times=3, delay=1):
+    last_error = None
+    for _ in range(times):
+        try:
+            return fn()
+        except Exception as exc:
+            last_error = exc
+            time.sleep(delay)
+    raise last_error
+
+
+def noop():
+    pass
